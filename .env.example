# =============================================================
# ELDERLY CARE EDGE AI CONFIG
# Copy this file to ".env" on Raspberry Pi, then edit secrets/device values.
# Keep ".env" private. Do not commit real API keys, MongoDB URI, or Wi-Fi
# setup password to Git.
# =============================================================

# =============================================================
# 1) Raspberry Pi / API runtime
# =============================================================
# systemd production service currently starts uvicorn on 0.0.0.0:8000.
# Keep these values aligned with deploy/systemd/elderly-care.service.
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
LATEST_RESULT_FRESH_SECONDS=90

# Relative paths are resolved from the service WorkingDirectory.
# Recommended on Pi: ./data. Avoid absolute paths with a stale Linux username.
ECG_DATA_DIR=./data
SAVE_LEGACY_RAW_CSV=0

# =============================================================
# 2) API security
# =============================================================
# For LAN demo only, API_AUTH_ENABLED=0 is acceptable.
# Before exposing over VPN/cloud/public network, set API_AUTH_ENABLED=1 and
# provide a long random API_KEY. Flutter app must use X-API-Key or api_key.
API_AUTH_ENABLED=1
API_KEY=diem10trongtay
API_PUBLIC_PATHS=/health,/dashboard
ALLOWED_ORIGINS=*

# =============================================================
# 3) Polar H10 BLE collector
# =============================================================
# Required on production Pi. Replace with your Polar H10 BLE MAC/address.
POLAR_H10_MAC=24:AC:AC:13:EB:86

# Installer sets POLAR_AUTO_START=1 on Pi even if this template is copied.
# Keep 1 for production so the Pi starts collection after boot.
POLAR_AUTO_START=1
POLAR_AUTO_START_CHUNK_SECONDS=10
POLAR_ENABLE_HR_STREAM=1
POLAR_ENABLE_ACC_STREAM=1
POLAR_CONNECT_TIMEOUT_SECONDS=20
POLAR_RECONNECT_SECONDS=10

# =============================================================
# 4) Model artifact paths and version guard
# =============================================================
# Current artifacts were trained with scikit-learn 1.8.0.
# If /health reports sklearn_version_ok=false, reinstall requirements.txt.
REQUIRED_SKLEARN_VERSION=1.8.0

MODEL_ROOT=models
STRESS_MODEL_DIR=models/stress

RHYTHM_MODEL_PATH=models/rhythm/rhythm_feature_model.pkl
RHYTHM_SCALER_PATH=models/rhythm/rhythm_scaler.pkl
RHYTHM_SCHEMA_PATH=models/rhythm/rhythm_feature_schema.json
RHYTHM_LABEL_MAP_PATH=models/rhythm/label_map.json
RHYTHM_DECISION_CONFIG_PATH=models/rhythm/rhythm_decision_config.json

ECTOPY_MODEL_PATH=models/ectopy/ectopy_feature_model.pkl
ECTOPY_SCALER_PATH=models/ectopy/ectopy_scaler.pkl
ECTOPY_SCHEMA_PATH=models/ectopy/ectopy_feature_schema.json
ECTOPY_LABEL_MAP_PATH=models/ectopy/ectopy_label_map.json

# Global legacy anomaly screening is enabled by default.
# Patient-specific anomaly calibration is disabled by default because it needs
# validated baseline data. Enable only after calibration has been reviewed.
ANOMALY_ENABLED=1
ANOMALY_CALIBRATION_ENABLED=0
ANOMALY_MODEL_PATH=models/anomaly_legacy/isolation_forest_model.pkl
ANOMALY_SCALER_PATH=models/anomaly_legacy/anomaly_scaler.pkl
ANOMALY_SCHEMA_PATH=models/anomaly_legacy/anomaly_feature_schema.json
ANOMALY_MIN_SIGNAL_QUALITY_SCORE=0.65
ANOMALY_DISTRIBUTION_GUARD_Z=25.0

# Optional runtime threshold overrides. Keep commented unless tuning.
# RHYTHM_AFIB_DECISION_MODE=probability_only
# RHYTHM_AFIB_EPISODE_THRESHOLD=0.05
# RHYTHM_AFIB_ALERT_THRESHOLD=0.3

# Sensor-context calibration from real REST/WALK/ACTIVE data.
SENSOR_CONTEXT_CONFIG_PATH=models/runtime/sensor_context_config.json
SENSOR_CONTEXT_CONFIG_DISABLED=0

# Training-only default for WESAD stress training.
WESAD_ROOT=data_raw/wesad

# =============================================================
# 5) MQTT alert delivery over LAN
# =============================================================
# Install broker on Pi:
#   sudo apt install -y mosquitto mosquitto-clients
#   sudo systemctl enable --now mosquitto
#
# Flutter/app topics:
#   elderly_care/<patient_id>/vitals/live
#   elderly_care/<patient_id>/alert
#   elderly_care/service/status
MQTT_ENABLED=1
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
# Optional. Leave commented so code auto-generates a process-specific ID.
# MQTT_CLIENT_ID=elderly_care_pi_001
MQTT_TOPIC_PREFIX=elderly_care
MQTT_QOS_VITALS=0
MQTT_QOS_ALERT=2
MQTT_KEEPALIVE=60
MQTT_ALERT_MIN_LEVEL=medium
MQTT_INCLUDE_RAW_SAMPLES=0

# =============================================================
# 6) Alert webhook (optional cloud/app-server POST)
# =============================================================
# Leave URL blank to disable webhook delivery.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_LEVELS=medium,high,critical

# =============================================================
# 7) MongoDB Atlas sync / cloud archive
# =============================================================
# MongoDB is NOT in the realtime alert critical path.
# Leave MONGODB_URI blank and MONGODB_SYNC_ENABLED=0 if you only need local
# SQLite operation. Set the real URI only in the private .env on Pi.
MONGODB_URI=mongodb+srv://elderly_care_app:Elderlycare.@elderly-care-cluster.piijdi3.mongodb.net/?appName=elderly-care-cluster
MONGODB_DB=elderly_care
MONGODB_BULK_BATCH_SIZE=200
MONGODB_SYNC_ENABLED=0
MONGODB_SYNC_INTERVAL_SECONDS=300
MONGODB_SYNC_PATIENT_ID=
MONGODB_SYNC_DAYS=1
MONGODB_SYNC_LIMIT=5000
MONGODB_SYNC_INCLUDE_RAW_SAMPLES=0
MONGODB_SYNC_PURGE_AFTER_SYNC=1
MONGODB_SYNC_PURGE_RETENTION_HOURS=24
MONGODB_SYNC_PURGE_LIMIT=10000
MONGODB_SYNC_RUN_IMMEDIATELY=1
MONGODB_SYNC_LOG_PATH=logs/background_sync.log
MONGODB_SYNC_RUN_LOG_PATH=logs/background_sync_runs.jsonl

# =============================================================
# 8) Wi-Fi provisioning / captive portal
# =============================================================
# If the Pi cannot connect to a known Wi-Fi, the root-owned provisioning
# service can start a setup AP:
#   SSID: ElderlyCare-Setup-XXXX
#   URL:  http://10.42.0.1
#
# If WIFI_AP_PASSWORD is blank, scripts/install_pi_production.sh generates a
# WPA2 password and writes it into the private .env.
WIFI_INTERFACE=wlan0
WIFI_AP_SSID_PREFIX=ElderlyCare-Setup
WIFI_AP_CONNECTION_NAME=elderly-care-setup-ap
WIFI_AP_PASSWORD=12345678
WIFI_SETUP_IP=10.42.0.1
WIFI_PORTAL_HOST=0.0.0.0
WIFI_PORTAL_PORT=80
WIFI_PROVISIONING_STATUS_PATH=/run/elderly-care/network_status.json
WIFI_PROVISIONING_STATE_DIR=/var/lib/elderly-care/wifi_provisioning
WIFI_SETUP_TRIGGER_PATH=/var/lib/elderly-care/wifi_setup_mode
WIFI_MONITOR_INTERVAL_SECONDS=60
WIFI_CONNECT_TIMEOUT_SECONDS=25
WIFI_INTERNET_CHECK_HOST=1.1.1.1
WIFI_INTERNET_CHECK_PORT=443

# =============================================================
# 9) Diagnostics / soak test
# =============================================================
PI_MONITOR_PROCESS_NAME=uvicorn
