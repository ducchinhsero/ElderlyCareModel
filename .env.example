# =============================================================
# ELDERLY CARE PI CONFIG (template — copy to .env and edit)
# =============================================================

# ---- Polar H10 BLE ----
POLAR_H10_MAC=24:AC:AC:13:EB:86

# ---- Storage ----
# Relative paths are resolved from the project/service WorkingDirectory.
# This avoids hard-coding a Linux username such as /home/custard.
ECG_DATA_DIR=./data
SAVE_LEGACY_RAW_CSV=0

# =============================================================
# MQTT — LOCAL alert delivery (Edge AI, no cloud dependency)
# =============================================================
# Install broker on Pi:
#   sudo apt install -y mosquitto mosquitto-clients
#   sudo systemctl enable --now mosquitto
# The Flutter app subscribes to:
#   elderly_care/<patient_id>/vitals/live   high-freq, QoS=0, not retained
#   elderly_care/<patient_id>/alert         critical, QoS=2, retained=true
#   elderly_care/service/status             online/offline (Last Will)
MQTT_ENABLED=1
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=elderly_care
MQTT_QOS_VITALS=0
MQTT_QOS_ALERT=2
MQTT_KEEPALIVE=60
MQTT_ALERT_MIN_LEVEL=medium
MQTT_INCLUDE_RAW_SAMPLES=0

# =============================================================
# Alert webhook (optional — HTTP POST when alert >= configured level)
# =============================================================
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_LEVELS=medium,high,critical

# =============================================================
# MongoDB Atlas — CLOUD ARCHIVE ONLY (NOT in alert critical path)
# =============================================================
MONGODB_URI=
MONGODB_DB=elderly_care
MONGODB_BULK_BATCH_SIZE=200
MONGODB_SYNC_ENABLED=0
MONGODB_SYNC_INTERVAL_SECONDS=300
MONGODB_SYNC_DAYS=1
MONGODB_SYNC_LIMIT=5000
MONGODB_SYNC_INCLUDE_RAW_SAMPLES=0
MONGODB_SYNC_PURGE_AFTER_SYNC=1
MONGODB_SYNC_PURGE_RETENTION_HOURS=24
MONGODB_SYNC_PURGE_LIMIT=10000
MONGODB_SYNC_RUN_IMMEDIATELY=1
MONGODB_SYNC_LOG_PATH=logs/background_sync.log
MONGODB_SYNC_RUN_LOG_PATH=logs/background_sync_runs.jsonl

# ---- API server ----
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
LATEST_RESULT_FRESH_SECONDS=90

# ---- Polar collector auto-start ----
# Set to 1 on production Raspberry Pi after POLAR_H10_MAC is correct.
# Keep 0 on development machines to avoid unwanted BLE connection attempts.
POLAR_AUTO_START=0
POLAR_AUTO_START_CHUNK_SECONDS=10
POLAR_ENABLE_HR_STREAM=1
POLAR_ENABLE_ACC_STREAM=1
POLAR_CONNECT_TIMEOUT_SECONDS=20
POLAR_RECONNECT_SECONDS=10

# =============================================================
# Wi-Fi provisioning / captive portal (Raspberry Pi production)
# =============================================================
# If the Pi cannot connect to a known Wi-Fi profile, this optional
# root-owned service can start a temporary setup AP:
#   SSID: ElderlyCare-Setup-XXXX
#   URL:  http://10.42.0.1
WIFI_INTERFACE=wlan0
WIFI_AP_SSID_PREFIX=ElderlyCare-Setup
WIFI_AP_PASSWORD=
WIFI_SETUP_IP=10.42.0.1
WIFI_PORTAL_HOST=0.0.0.0
WIFI_PORTAL_PORT=80
WIFI_PROVISIONING_STATUS_PATH=/run/elderly-care/network_status.json
WIFI_PROVISIONING_STATE_DIR=/var/lib/elderly-care/wifi_provisioning
WIFI_SETUP_TRIGGER_PATH=/var/lib/elderly-care/wifi_setup_mode
WIFI_MONITOR_INTERVAL_SECONDS=60
WIFI_INTERNET_CHECK_HOST=1.1.1.1
WIFI_INTERNET_CHECK_PORT=443

# ---- API security (enable before exposing outside LAN/VPN) ----
API_AUTH_ENABLED=0
API_KEY=
API_PUBLIC_PATHS=/health,/dashboard
ALLOWED_ORIGINS=*
