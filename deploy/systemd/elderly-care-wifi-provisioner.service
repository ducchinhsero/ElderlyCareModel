[Unit]
Description=Elderly Care Wi-Fi Provisioning Portal
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
User=root
WorkingDirectory=/home/elcaprj/elderly_care
EnvironmentFile=-/home/elcaprj/elderly_care/.env
RuntimeDirectory=elderly-care
RuntimeDirectoryMode=0755
StateDirectory=elderly-care
StateDirectoryMode=0700
ExecStartPre=/bin/mkdir -p /run/elderly-care /var/lib/elderly-care/wifi_provisioning
ExecStart=/home/elcaprj/elderly_care/.venv/bin/python -m src.network.provisioning
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target

